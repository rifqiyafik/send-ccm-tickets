LOG_LEVEL=info
# LOG_LEVEL pilihan: debug, info, warn, error, silent.
# LOG_COLOR=false untuk mematikan warna ANSI jika terminal tidak mendukung.
LOG_COLOR=true
APP_ENV=production
APP_RUNTIME_ENV_PATH=data/runtime/app_runtime_env.json
# Optional untuk Docker Compose deploy. Isi dengan image registry di VM.
# Contoh: ghcr.io/username/send-ccm-ticket:latest
APP_IMAGE=send-ccm-ticket:latest
# Linux VM: isi dengan hasil command `id -u` dan `id -g` agar container bisa write bind mount.
APP_UID=1000
APP_GID=1000
# BAILEYS_LOG_LEVEL pilihan: silent, fatal, error, warn, info, debug, trace.
# Biarkan silent agar log internal Baileys tidak memenuhi terminal.
BAILEYS_LOG_LEVEL=silent
# Optional. Pakai jika fetchLatestBaileysVersion memberi versi lama dan koneksi 408.
WA_WEB_VERSION=
# Fallback single-session auth dir. Multi-session memakai WA_SESSION_ROOT.
WA_AUTH_DIR=sessions/baileys
WA_SESSION_ROOT=sessions/whatsapp
WA_SESSION_REGISTRY_PATH=data/runtime/whatsapp_sessions.json
WA_AUTO_START=false
# Optional override path reference data. Kosongkan untuk memakai data bawaan image.
CCM_HANDLING_DATA_PATH=
NOP_SITE_DATA_PATH=

# Telegram command center.
# Buat bot dari BotFather, isi token di sini, lalu chat bot sekali.
# Jika TELEGRAM_ADMIN_CHAT_IDS kosong, bot akan membalas Chat ID kamu saat command dikirim.
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_IDS=
TELEGRAM_POLL_TIMEOUT_SECONDS=30
TELEGRAM_ACCESS_CONFIG_PATH=config/telegram.json

# Optional. Isi jika command .groups/.private boleh dipakai nomor admin selain akun bot.
# JID di sini juga otomatis diizinkan memakai bot dari private chat.
# Format JID private: 628xxxxxxxxxx@s.whatsapp.net atau 109xxxxx@lid jika Baileys menampilkan LID.
OWNER_JIDS=
JID_SEARCH_LIMIT=50

# Mode Telegram-Only: Nonaktifkan respon chat & command langsung via WhatsApp.
# Jika true, bot mengabaikan seluruh pesan/dokumen masuk di WhatsApp. Bot hanya dikontrol via Telegram.
WA_DISABLE_INCOMING=false


# Anti-spam pacing (Adaptive Jitter Delay) untuk pesan eskalasi tiket.
# Delay acak minimum & maksimum per tiket (ms):
WA_SEND_DELAY_MIN_MS=8000
WA_SEND_DELAY_MAX_MS=13000
# Opsional fixed fallback delay jika min/max tidak diisi (ms):
# WA_SEND_DELAY_MS=10000
# Jumlah tiket per batch:
WA_BATCH_SIZE=10
# Extra delay saat mencapai kelipatan batch (ms):
WA_BATCH_EXTRA_DELAY_MS=5000

# Jeda acak (Random Jitter Delay) khusus command .reminder (1 sampai 2 menit, Anti-Ban WA):
WA_REMINDER_DELAY_MIN_MS=60000
WA_REMINDER_DELAY_MAX_MS=120000
TELEGRAM_REMINDER_DELAY_MS=5000

# Jeda acak (Random Jitter Delay) khusus command .summary (rekap):
WA_SUMMARY_DELAY_MIN_MS=30000
WA_SUMMARY_DELAY_MAX_MS=60000
TELEGRAM_SUMMARY_DELAY_MS=5000

# Simulasi Membaca Pesan (Mark as Read / Centang 2 Biru Alami):
# Jika true, pesan yang diterima bot otomatis ditandai centang 2 biru setelah jeda membaca alami.
WA_AUTO_READ=true
WA_AUTO_READ_DELAY_MIN_MS=1500
WA_AUTO_READ_DELAY_MAX_MS=4000

# Jeda delay antar perpindahan target group / assignment (ms):
TARGET_GROUP_COMPLETION_DELAY_MS=10000
# Auto-retry pengiriman pesan saat socket terputus:
WA_RETRY_MAX_ATTEMPTS=3
WA_RETRY_BACKOFF_MS=3000
SENT_TICKET_STORE_PATH=data/runtime/sent_tickets.json
SENT_TICKET_RETENTION_DAYS=7

# Optional fallback routing lama. Prefer pakai target_groups di config/whatsapp.json.
# Jika kosong dan target_groups tidak cocok, tiket dikirim balik ke chat pengirim file.
# Format: KEY:whatsapp_jid,KEY2:whatsapp_jid
# KEY bisa nama PIC, NSA, atau assignment_type seperti SQA/NOP.
# Contoh:
# WHATSAPP_GROUPS=HERMAN:120363000000000000@g.us,RIZLUL KHAIRI:120363111111111111@g.us,SQA:120363222222222222@g.us
WHATSAPP_GROUPS=

# ==============================================================================
# Auto-Polling Database (ClickHouse L2 Assign Source)
# ==============================================================================
DB_POLL_ENABLED=false
DB_POLL_INTERVAL_MINUTES=5
DB_POLL_START_HOUR=7
DB_POLL_END_HOUR=17
CLICKHOUSE_HOST=10.37.159.112
CLICKHOUSE_PORT=9443
CLICKHOUSE_NAME=default
CLICKHOUSE_USER=your_db_username
CLICKHOUSE_PASSWORD="your_db_password"

# ==============================================================================
# PostgreSQL Database (SQA_SUMBAGUT Storage Server)
# ==============================================================================
PG_HOST=10.54.18.63
PG_PORT=5432
PG_DATABASE=production
PG_USER=your_pg_username
PG_PASSWORD="your_pg_password"
PG_SCHEMA=SQA_SUMBAGUT


